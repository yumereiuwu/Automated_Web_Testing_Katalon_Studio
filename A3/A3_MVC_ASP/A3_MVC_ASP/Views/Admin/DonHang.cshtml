@model System.Collections.Generic.List<A3_MVC_ASP.Models.DonHang>
@{
    ViewBag.Title = "Đơn hàng";
    var page = ViewBag.Page != null ? (int)ViewBag.Page : 1;
    var totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
    var pageSize = ViewBag.PageSize != null ? (int)ViewBag.PageSize : 10;
    var totalItems = ViewBag.TotalItems != null ? (int)ViewBag.TotalItems : Model.Count;
    var sttStart = (page - 1) * pageSize + 1;
    Func<string, string> hienThiTrangThai = s =>
    {
        switch (s ?? "")
        {
            case "ChoDuyet": return "Chờ duyệt";
            case "DaXacNhan": return "Đã xác nhận";
            case "DangGiao": return "Đang giao";
            case "DaGiao": return "Đã giao";
            case "DaHuy": return "Đã hủy";
            default: return s ?? "";
        }
    };
}
<div class="admin-panel">
    <div class="admin-table-wrap">
        <table class="table table-bordered table-hover admin-table">
            <thead>
                <tr><th>STT</th><th>Mã đơn</th><th>Khách</th><th>Ngày đặt</th><th>Tổng</th><th>Trạng thái</th><th>Thao tác</th></tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Count; i++)
                {
                    var d = Model[i];
                    <tr>
                        <td>@(sttStart + i)</td>
                        <td>@d.MaDon</td>
                        <td>@d.TenKhachHang</td>
                        <td>@d.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@d.TongThanhToan.ToString("N0") đ</td>
                        <td>@hienThiTrangThai(d.TrangThai)</td>
                        <td>
                            <a href="@Url.Action("DonHangXem", new { id = d.MaDonHang })" class="btn btn-admin-edit btn-sm">Chi tiết</a>
                            @using (Html.BeginForm("DonHangXoa", "Admin", FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Bạn đã chắc chắn muốn xóa chưa?');" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@d.MaDonHang" />
                                <input type="hidden" name="page" value="@page" />
                                <button type="submit" class="btn btn-danger btn-admin-del btn-sm ms-1">
                                    <i class="bi bi-trash-fill" aria-hidden="true"></i> Xóa
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="small text-muted">Tổng @totalItems đơn hàng</div>
            <nav aria-label="Phân trang đơn hàng">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(page <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("DonHang", new { page = page - 1 })">Trước</a>
                    </li>
                    @for (var p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == page ? "active" : "")">
                            <a class="page-link" href="@Url.Action("DonHang", new { page = p })">@p</a>
                        </li>
                    }
                    <li class="page-item @(page >= totalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("DonHang", new { page = page + 1 })">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
