@model A3_MVC_ASP.Models.SanPhamAdminDetailVm
@{
    ViewBag.Title = "Chi tiết sản phẩm";
    var img = string.IsNullOrWhiteSpace(Model.HinhAnh)
        ? Url.Content("~/Content/SanPhamImages/placeholder.svg")
        : Url.Content("~/Content/SanPhamImages/" + Model.HinhAnh);
    var phanTramGiamText = Model.PhanTramGiam > 0 ? Model.PhanTramGiam.ToString("N0.##") + "%" : "0%";
}

<div class="admin-panel">
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="border rounded p-2 bg-light">
                <img src="@img"
                     alt="@Model.TenSanPham"
                     class="img-fluid rounded"
                     style="width: 100%; max-height: 360px; object-fit: contain; background: #fff;"
                     onerror="this.onerror=null;this.src='@Url.Content("~/Content/SanPhamImages/placeholder.svg")';" />
            </div>
        </div>
        <div class="col-lg-8">
            <h2 class="h5 fw-bold mb-3">@Model.TenSanPham</h2>
            <dl class="row small mb-0">
                <dt class="col-sm-4">Mã sản phẩm</dt>
                <dd class="col-sm-8">@Model.MaSanPham</dd>

                <dt class="col-sm-4">Danh mục</dt>
                <dd class="col-sm-8">@Model.TenDanhMuc</dd>

                <dt class="col-sm-4">Nhà cung cấp</dt>
                <dd class="col-sm-8">@Model.TenNhaCungCap</dd>

                <dt class="col-sm-4">Giá nhập</dt>
                <dd class="col-sm-8">@Model.GiaNhap.ToString("N0") đ</dd>

                <dt class="col-sm-4">Giá bán</dt>
                <dd class="col-sm-8">@Model.GiaBan.ToString("N0") đ</dd>

                <dt class="col-sm-4">Giảm giá</dt>
                <dd class="col-sm-8">@phanTramGiamText</dd>

                <dt class="col-sm-4">Giá sau giảm</dt>
                <dd class="col-sm-8 fw-semibold">@Model.GiaSauGiam.ToString("N0") đ</dd>

                <dt class="col-sm-4">Số lượng tồn</dt>
                <dd class="col-sm-8">@Model.SoLuongTon @Model.DonViTinh</dd>

                <dt class="col-sm-4">Hiệu lực</dt>
                <dd class="col-sm-8">@(Model.ConHoatDong ? "Đang bán" : "Ngưng bán")</dd>

                <dt class="col-sm-4">Ngày tạo</dt>
                <dd class="col-sm-8">@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-4">Tên file ảnh</dt>
                <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(Model.HinhAnh) ? Model.HinhAnh : "(Không có)")</dd>
            </dl>
        </div>
    </div>

    <hr />
    <h3 class="h6 fw-bold">Mô tả sản phẩm</h3>
    <div class="border rounded p-3 bg-light small" style="white-space: pre-line;">
        @(!string.IsNullOrWhiteSpace(Model.MoTa) ? Model.MoTa : "Chưa có mô tả.")
    </div>

    <div class="mt-3">
        <a href="@Url.Action("SanPham")" class="btn btn-outline-secondary admin-product-back-btn">
            <i class="bi bi-arrow-left-short"></i> Quay lại sản phẩm
        </a>
        <a href="@Url.Action("SanPhamSua", new { id = Model.MaSanPham })" class="btn btn-primary admin-product-edit-btn ms-1">
            <i class="bi bi-pencil-square me-1"></i>Sửa sản phẩm
        </a>
    </div>
</div>

<style>
    .admin-product-back-btn,
    .admin-product-edit-btn {
        min-width: 150px;
        padding: 0.45rem 0.9rem;
        font-weight: 600;
        border-radius: 10px;
    }

    .admin-product-edit-btn {
        box-shadow: 0 6px 14px rgba(37, 99, 235, 0.25);
    }
</style>
