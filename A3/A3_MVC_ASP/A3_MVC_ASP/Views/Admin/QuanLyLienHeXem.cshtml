@model A3_MVC_ASP.Models.LienHe
@{
    ViewBag.Title = "Chi tiết liên hệ";
}
<div class="admin-panel">
    <dl class="row small mb-0">
        <dt class="col-sm-3">Họ tên</dt>
        <dd class="col-sm-9">@Model.HoTen</dd>
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Điện thoại</dt>
        <dd class="col-sm-9">@(Model.SoDienThoai ?? "—")</dd>
        <dt class="col-sm-3">Tiêu đề</dt>
        <dd class="col-sm-9">@Model.TieuDe</dd>
        <dt class="col-sm-3">Ngày gửi</dt>
        <dd class="col-sm-9">@Model.NgayGui.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt class="col-sm-3">Nội dung</dt>
        <dd class="col-sm-9"><div class="border rounded p-2 bg-light">@Model.NoiDung</div></dd>
    </dl>
    <div class="mt-3">
        <a href="@Url.Action("QuanLyLienHe")" class="btn btn-outline-secondary btn-sm">← Danh sách</a>
    </div>
</div>
