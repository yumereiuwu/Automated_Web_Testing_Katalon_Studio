@model System.Collections.Generic.List<A3_MVC_ASP.Models.NguoiDung>
@{
    ViewBag.Title = "Tài khoản";
    var page = ViewBag.Page != null ? (int)ViewBag.Page : 1;
    var totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
    var pageSize = ViewBag.PageSize != null ? (int)ViewBag.PageSize : 10;
    var totalItems = ViewBag.TotalItems != null ? (int)ViewBag.TotalItems : Model.Count;
    var sttStart = (page - 1) * pageSize + 1;
}
<div class="admin-panel">
    <div class="admin-table-wrap">
        <table class="table table-bordered table-hover admin-table">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>ID</th>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Hoạt động</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Count; i++)
                {
                    var u = Model[i];
                    <tr>
                        <td>@(sttStart + i)</td>
                        <td>@u.MaNguoiDung</td>
                        <td>@u.HoTen</td>
                        <td>@u.Email</td>
                        <td>@u.VaiTro</td>
                        <td>@(u.ConHoatDong ? "Có" : "Khóa")</td>
                        <td>
                            @if (u.VaiTro == "QuanTri")
                            {
                                <span class="small text-muted">Quản trị</span>
                            }
                            else
                            {
                                using (Html.BeginForm("QuanLyTaiKhoanKhoa", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.MaNguoiDung" />
                                    <button type="submit" class="btn btn-sm @(u.ConHoatDong ? "btn-outline-warning" : "btn-outline-success")" onclick="return confirm('Đổi trạng thái khóa tài khoản này?');">
                                        @(u.ConHoatDong ? "Khóa" : "Mở khóa")
                                    </button>
                                }
                                using (Html.BeginForm("QuanLyTaiKhoanXoa", "Admin", FormMethod.Post, new { @class = "d-inline ms-1", onsubmit = "return confirm('Bạn đã chắc chắn muốn xóa tài khoản này chưa?');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.MaNguoiDung" />
                                    <input type="hidden" name="page" value="@page" />
                                    <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="small text-muted">Tổng @totalItems tài khoản</div>
            <nav aria-label="Phân trang tài khoản">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(page <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("QuanLyTaiKhoan", new { page = page - 1 })">Trước</a>
                    </li>
                    @for (var p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == page ? "active" : "")">
                            <a class="page-link" href="@Url.Action("QuanLyTaiKhoan", new { page = p })">@p</a>
                        </li>
                    }
                    <li class="page-item @(page >= totalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("QuanLyTaiKhoan", new { page = page + 1 })">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
