@model A3_MVC_ASP.Models.DanhMucFormVm
@{
    ViewBag.Title = "Sửa danh mục";
}
<div class="admin-panel">
    @using (Html.BeginForm("DanhMucSua", "Admin", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.MaDanhMuc)
        @Html.ValidationSummary(true, "", new { @class = "text-danger small" })
        <div class="mb-3">
            @Html.LabelFor(m => m.TenDanhMuc, new { @class = "form-label small fw-semibold" })
            @Html.TextBoxFor(m => m.TenDanhMuc, new { @class = "form-control form-control-sm", maxlength = "200" })
            @Html.ValidationMessageFor(m => m.TenDanhMuc, "", new { @class = "text-danger small" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.MoTa, "Ghi chú / Mô tả", new { @class = "form-label small fw-semibold" })
            @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control form-control-sm", rows = "4" })
        </div>
        <div class="form-check mb-3">
            @Html.CheckBoxFor(m => m.ConHoatDong, new { @class = "form-check-input" })
            @Html.LabelFor(m => m.ConHoatDong, "Đang hoạt động", new { @class = "form-check-label small" })
        </div>
        <button type="submit" class="btn btn-success btn-sm">Cập nhật</button>
        <a href="@Url.Action("DanhMuc")" class="btn btn-outline-secondary btn-sm">Quay lại</a>
    }
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
