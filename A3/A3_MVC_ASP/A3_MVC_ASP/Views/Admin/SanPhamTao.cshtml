@model A3_MVC_ASP.Models.SanPhamFormVm
@using System.Web.Mvc
@{
    ViewBag.Title = "Thêm sản phẩm";
    var dsDanhMuc = ViewBag.DanhMucs as System.Collections.Generic.List<A3_MVC_ASP.Models.DanhMuc>;
    var dsNhaCungCap = ViewBag.NhaCungCaps as System.Collections.Generic.List<A3_MVC_ASP.Models.NhaCungCap>;
}
<div class="admin-panel mx-auto" style="max-width: 720px;">
    @using (Html.BeginForm("SanPhamTao", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="mb-2"><label class="form-label">Tên</label>@Html.TextBoxFor(m => m.TenSanPham, new { @class = "form-control" })</div>
        <div class="mb-2"><label class="form-label">Danh mục</label>@Html.DropDownListFor(m => m.MaDanhMuc, new SelectList(dsDanhMuc ?? new System.Collections.Generic.List<A3_MVC_ASP.Models.DanhMuc>(), "MaDanhMuc", "TenDanhMuc"), "-- Chọn --", new { @class = "form-select" })</div>
        <div class="mb-2"><label class="form-label">Nhà cung cấp</label>@Html.DropDownListFor(m => m.MaNhaCungCap, new SelectList(dsNhaCungCap ?? new System.Collections.Generic.List<A3_MVC_ASP.Models.NhaCungCap>(), "MaNhaCungCap", "TenNhaCungCap"), "(Không)", new { @class = "form-select" })</div>
        <div class="mb-2"><label class="form-label">Mô tả</label>@Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = 3 })</div>
        <div class="row">
            <div class="col-md-4 mb-2">
                <label class="form-label">Giá nhập</label>
                <input id="GiaNhapText" class="form-control js-money" inputmode="numeric" autocomplete="off" value="@(Model != null ? Model.GiaNhap.ToString("N0") : "")" />
                @Html.HiddenFor(m => m.GiaNhap, new { id = "GiaNhap" })
            </div>
            <div class="col-md-4 mb-2">
                <label class="form-label">Giá bán</label>
                <input id="GiaBanText" class="form-control js-money" inputmode="numeric" autocomplete="off" value="@(Model != null ? Model.GiaBan.ToString("N0") : "")" />
                @Html.HiddenFor(m => m.GiaBan, new { id = "GiaBan" })
            </div>
            <div class="col-md-4 mb-2"><label class="form-label">Giảm %</label>@Html.TextBoxFor(m => m.PhanTramGiam, new { @class = "form-control", type = "number", step = "0.1" })</div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-2"><label class="form-label">Tồn ban đầu</label>@Html.TextBoxFor(m => m.SoLuongTon, new { @class = "form-control", type = "number" })</div>
            <div class="col-md-4 mb-2"><label class="form-label">Đơn vị</label>@Html.TextBoxFor(m => m.DonViTinh, new { @class = "form-control" })</div>
            <div class="col-md-4 mb-2">
                <label class="form-label">Hình ảnh</label>
                <input type="file" name="AnhUpload" class="form-control" accept="image/*" />
                <div class="form-text">Chọn ảnh từ máy. Nếu không chọn sẽ dùng tên file trong ô bên dưới.</div>
                @Html.TextBoxFor(m => m.HinhAnh, new { @class = "form-control mt-1", placeholder = "Ví dụ: banhtrang.jpg (tuỳ chọn)" })
            </div>
        </div>
        <div class="mb-3 form-check">@Html.CheckBoxFor(m => m.ConHoatDong, new { @class = "form-check-input" }) <label class="form-check-label">Đang bán</label></div>
        <button type="submit" class="btn btn-success btn-sm">Lưu</button>
        <a href="@Url.Action("SanPham")" class="btn btn-outline-secondary btn-sm">Hủy</a>
    }
</div>

@section scripts {
    <script>
        (function () {
            function chiSo(s) { return (s || '').toString().replace(/[^\d]/g, ''); }
            function dinhDangVn(n) {
                n = chiSo(n);
                if (!n) return '';
                return n.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
            }
            function dongBoSo(textId, hiddenId) {
                var oNhap = document.getElementById(textId);
                var oAn = document.getElementById(hiddenId);
                if (!oNhap || !oAn) return;
                oAn.value = chiSo(oNhap.value);
            }
            document.addEventListener('input', function (e) {
                var el = e.target;
                if (!el || !el.classList || !el.classList.contains('js-money')) return;
                var pos = el.selectionStart;
                var before = el.value;
                el.value = dinhDangVn(before);
                dongBoSo('GiaNhapText', 'GiaNhap');
                dongBoSo('GiaBanText', 'GiaBan');
                try { el.setSelectionRange(pos, pos); } catch (_) { }
            }, true);

            // init
            dongBoSo('GiaNhapText', 'GiaNhap');
            dongBoSo('GiaBanText', 'GiaBan');
        })();
    </script>
}
