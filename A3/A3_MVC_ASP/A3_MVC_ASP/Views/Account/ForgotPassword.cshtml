@model A3_MVC_ASP.Models.ForgotPasswordVm
@{
    ViewBag.Title = "Quên mật khẩu";
}

<div class="container body-content-page" style="max-width: 520px;">
    <h2 class="fw-bold mb-4" style="color: #9a1830;">Quên mật khẩu</h2>
    <p class="text-muted small">Bước 1: nhập email để nhận OTP. Bước 2: nhập OTP và mật khẩu mới.</p>
    @if (ViewBag.Info != null)
    {
        <div class="alert alert-info py-2">@ViewBag.Info</div>
    }

    @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.IsOtpStep)
        @Html.ValidationSummary(true, "", new { @class = "text-danger small" })

        <div class="mb-3">
            <label class="form-label">Email</label>
            @if (Model != null && Model.IsOtpStep)
            {
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "email@...", @readonly = "readonly" })
            }
            else
            {
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "email@..." })
            }
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
        </div>

        if (Model != null && Model.IsOtpStep)
        {
            <div class="mb-3">
                <label class="form-label">Mã OTP</label>
                @Html.TextBoxFor(m => m.Otp, new { @class = "form-control", placeholder = "Nhập mã OTP 6 số" })
                @Html.ValidationMessageFor(m => m.Otp, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                <label class="form-label">Mật khẩu mới</label>
                <div class="position-relative">
                    @Html.PasswordFor(m => m.MatKhauMoi, new { @class = "form-control pe-5", id = "fpNewPassword" })
                    <button class="btn btn-link text-secondary text-decoration-none position-absolute top-50 end-0 translate-middle-y me-2 p-0 d-none"
                            type="button"
                            id="toggleFpNewPassword"
                            aria-label="Hiện hoặc ẩn mật khẩu mới">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.MatKhauMoi, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                <label class="form-label">Xác nhận mật khẩu mới</label>
                <div class="position-relative">
                    @Html.PasswordFor(m => m.XacNhanMatKhauMoi, new { @class = "form-control pe-5", id = "fpConfirmPassword" })
                    <button class="btn btn-link text-secondary text-decoration-none position-absolute top-50 end-0 translate-middle-y me-2 p-0 d-none"
                            type="button"
                            id="toggleFpConfirmPassword"
                            aria-label="Hiện hoặc ẩn xác nhận mật khẩu">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.XacNhanMatKhauMoi, "", new { @class = "text-danger small" })
            </div>
        }

        <button type="submit" class="btn btn-danger">@(Model != null && Model.IsOtpStep ? "Xác nhận đổi mật khẩu" : "Gửi mã OTP")</button>
        <a href="@Url.Action("Login", "Account")" class="btn btn-outline-secondary ms-2">Quay lại đăng nhập</a>
    }
</div>

@section scripts {
    <script>
        (function () {
            function ganNutMat(inputId, buttonId) {
                var oNhap = document.getElementById(inputId);
                var nut = document.getElementById(buttonId);
                if (!oNhap || !nut) return;

                var dongBo = function () {
                    var coChu = (oNhap.value || "").trim().length > 0;
                    nut.classList.toggle("d-none", !coChu);
                    if (!coChu) {
                        oNhap.type = "password";
                        nut.innerHTML = '<i class="bi bi-eye"></i>';
                    }
                };

                nut.addEventListener("click", function () {
                    var dangHien = oNhap.type === "text";
                    oNhap.type = dangHien ? "password" : "text";
                    nut.innerHTML = dangHien ? '<i class="bi bi-eye"></i>' : '<i class="bi bi-eye-slash"></i>';
                });

                oNhap.addEventListener("input", dongBo);
                dongBo();
            }

            ganNutMat("fpNewPassword", "toggleFpNewPassword");
            ganNutMat("fpConfirmPassword", "toggleFpConfirmPassword");
        })();
    </script>
}
