@model A3_MVC_ASP.Models.HomeIndexVm
@{
    ViewBag.Title = "Trang chủ";
}

<section class="home-banner-wrap" aria-label="Banner khuyến mãi">
    <div class="container">
        <div id="homeBannerCarousel"
             class="carousel slide home-banner-carousel"
             data-bs-ride="carousel"
             data-bs-interval="4000"
             data-bs-wrap="true">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#homeBannerCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Banner 1"></button>
                <button type="button" data-bs-target="#homeBannerCarousel" data-bs-slide-to="1" aria-label="Banner 2"></button>
                <button type="button" data-bs-target="#homeBannerCarousel" data-bs-slide-to="2" aria-label="Banner 3"></button>
            </div>
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img class="d-block w-100" src="@Url.Content("~/HinhAnh/banner/banner1.jpg")" alt="Banner 1" />
                </div>
                <div class="carousel-item">
                    <img class="d-block w-100" src="@Url.Content("~/HinhAnh/banner/banner2.jpg")" alt="Banner 2" />
                </div>
                <div class="carousel-item">
                    <img class="d-block w-100" src="@Url.Content("~/HinhAnh/banner/banner3.jpg")" alt="Banner 3" />
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#homeBannerCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Trước</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#homeBannerCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Sau</span>
            </button>
        </div>
    </div>
</section>

<style>
    .home-sections-wrap a.home-post-link,
    .home-sections-wrap a.home-post-link:hover,
    .home-sections-wrap a.home-post-link:focus,
    .home-sections-wrap a.home-post-link:active,
    .home-sections-wrap a.home-post-link h3,
    .home-sections-wrap a.home-post-link p {
        text-decoration: none !important;
    }
</style>

<section class="home-sections-wrap">
    <div class="container body-content-page">
        <div class="home-section-block">
            <h2 class="home-section-title"><i class="bi bi-tag-fill"></i>DANH MỤC SẢN PHẨM</h2>
            <div class="row g-3">
                @if (Model?.DanhMucs != null)
                {
                    foreach (var dm in Model.DanhMucs)
                    {
                        <div class="col-6 col-md-3">
                            <a href="@Url.Action("Index", "SanPham", new { dm = dm.TenDanhMuc })" class="home-cat-item">
                                <div class="home-cat-thumb">
                                    <img src="@Url.Content("~/HinhAnh/danhmuc/" + (dm.HinhAnh ?? "douong.jpg"))"
                                         alt="@dm.TenDanhMuc"
                                         onerror="this.onerror=null;this.src='@Url.Content("~/Content/SanPhamImages/placeholder.svg")';" />
                                    <div class="home-cat-overlay">
                                        @(dm.SoLuongSanPham) sản phẩm
                                    </div>
                                </div>
                                <span>@dm.TenDanhMuc</span>
                            </a>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="home-section-block">
            <h2 class="home-section-title"><i class="bi bi-handbag-fill"></i>SẢN PHẨM BÁN CHẠY</h2>
            <div class="row g-3">
                @if (Model?.SanPhamBanChays != null)
                {
                    foreach (var sp in Model.SanPhamBanChays)
                    {
                        <div class="col-12 col-md-6 col-lg-3">
                            <a class="home-product-card" href="@Url.Action("ChiTiet", "SanPham", new { id = sp.MaSanPham })">
                                <div class="home-product-thumb">
                                    <img src="@Url.Content("~/Content/SanPhamImages/" + (sp.HinhAnh ?? "no-image.png"))"
                                         alt="@sp.TenSanPham"
                                         onerror="this.onerror=null;this.src='@Url.Content("~/Content/SanPhamImages/placeholder.svg")';" />
                                </div>
                                <div class="home-product-body">
                                    <small>@sp.TenDanhMuc</small>
                                    <h3>@sp.TenSanPham</h3>
                                    <strong>@sp.GiaBan.ToString("N0") đ</strong>
                                </div>
                            </a>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="home-section-block">
            <h2 class="home-section-title"><i class="bi bi-gift-fill"></i>SẢN PHẨM GIẢM GIÁ</h2>
            <div class="row g-3">
                @if (Model?.SanPhamGiamGias != null)
                {
                    foreach (var sp in Model.SanPhamGiamGias)
                    {
                        var giaSauGiam = sp.GiaBan * (100 - sp.PhanTramGiam) / 100;
                        <div class="col-12 col-md-6 col-lg-3">
                            <a class="home-product-card discount" href="@Url.Action("ChiTiet", "SanPham", new { id = sp.MaSanPham })">
                                <div class="home-product-thumb">
                                    <span class="home-discount-badge">Giảm @sp.PhanTramGiam.ToString("N0")%</span>
                                    <img src="@Url.Content("~/Content/SanPhamImages/" + (sp.HinhAnh ?? "no-image.png"))"
                                         alt="@sp.TenSanPham"
                                         onerror="this.onerror=null;this.src='@Url.Content("~/Content/SanPhamImages/placeholder.svg")';" />
                                </div>
                                <div class="home-product-body">
                                    <small>@sp.TenDanhMuc</small>
                                    <h3>@sp.TenSanPham</h3>
                                    <div>
                                        <del>@sp.GiaBan.ToString("N0") đ</del>
                                        <strong>@giaSauGiam.ToString("N0") đ</strong>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="home-section-block mb-0">
            <h2 class="home-section-title"><i class="bi bi-gift-fill"></i>BÀI VIẾT NỔI BẬT</h2>
            <div class="row g-3">
                @if (Model?.BaiVietNoiBats != null)
                {
                    foreach (var post in Model.BaiVietNoiBats)
                    {
                        <div class="col-12 col-md-6 col-lg-3">
                            <a class="home-post-link" href="@Url.Action("ChiTiet", "TinTuc", new { id = post.MaBaiViet })">
                                <article class="home-post-card">
                                    <span class="home-post-date">@post.NgayText</span>
                                    <h3>@post.TieuDe</h3>
                                    <p>@post.TomTat</p>
                                </article>
                            </a>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>
