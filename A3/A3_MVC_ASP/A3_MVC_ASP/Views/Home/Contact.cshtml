@{
    ViewBag.Title = "Liên hệ";
}
<div class="container body-content-page">
    <main aria-labelledby="title">
        <h2 id="title" class="fw-bold" style="color: #9a1830;">@ViewBag.Title</h2>
        <p class="lead text-muted">@ViewBag.Message</p>
        <address class="mb-0">
            <strong>Hotline:</strong> 0901 234 567<br />
            <strong>Email:</strong> <a href="mailto:hotro@phoanvat.local">hotro@phoanvat.local</a><br />
            <span class="text-muted">Giờ làm việc: 8:00 — 21:00 hằng ngày</span>
        </address>
        <p class="small text-muted mt-3 mb-0" id="faq"><strong>FAQ:</strong> Miễn phí ship đơn từ 150.000đ (nội thành).</p>
    </main>
</div>
