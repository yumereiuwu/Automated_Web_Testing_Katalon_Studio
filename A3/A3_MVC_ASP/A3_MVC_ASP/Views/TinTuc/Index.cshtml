@{
    ViewBag.Title = "Tin tức";
}
<div class="container body-content-page news-page">
    <h2 class="fw-bold mb-4 news-page-title">Tin tức &amp; khuyến mãi</h2>

    <div class="row g-3">
        <div class="col-12 col-md-6">
            <div class="news-card h-100">
                <h5 class="news-card-title">Khuyến mãi / ưu đãi</h5>
                <ul class="news-list mb-0">
                    <li>Mua 2 tặng 1 snack Oishi</li>
                    <li>Freeship đơn từ 99k</li>
                    <li>Sale cuối tuần giảm 20%</li>
                </ul>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="news-card h-100">
                <h5 class="news-card-title">Sản phẩm mới về</h5>
                <ul class="news-list mb-0">
                    <li>Đã có bim bim Toonies vị mới</li>
                    <li>Combo snack học sinh mới cập bến</li>
                    <li>Socola nhập khẩu mới về shop</li>
                </ul>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="news-card h-100">
                <h5 class="news-card-title">Review / gợi ý ăn vặt</h5>
                <ul class="news-list mb-0">
                    <li>Top 5 món ăn vặt hot nhất tháng này</li>
                    <li>Đồ ăn vặt xem phim cực hợp</li>
                    <li>Combo ăn đêm dưới 50k</li>
                </ul>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="news-card h-100">
                <h5 class="news-card-title">Kiến thức / mẹo nhỏ</h5>
                <ul class="news-list mb-0">
                    <li>Cách bảo quản snack giòn lâu</li>
                    <li>Ăn socola sao cho ngon</li>
                    <li>Đồ ăn vặt phù hợp dân văn phòng</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');

    .news-page,
    .news-page * {
        font-family: 'Poppins', 'Be Vietnam Pro', sans-serif;
    }

    .news-page .news-page-title {
        color: #2f4f1f;
    }

    .news-page .news-card {
        background: #fff;
        border: 1px solid #e7e7e7;
        border-radius: 14px;
        box-shadow: 0 8px 20px rgba(21, 21, 21, 0.08);
        padding: 1rem 1.05rem;
    }

    .news-page .news-card-title {
        color: #5f2b3b;
        font-weight: 700;
        margin-bottom: 0.65rem;
    }

    .news-page .news-list {
        padding-left: 1.15rem;
        color: #424242;
        line-height: 1.65;
    }
</style>
