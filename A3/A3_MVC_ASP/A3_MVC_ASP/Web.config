	<connectionStrings>
		<add name="DoAnVatA3Connection"
             connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=DoAnVatA3;Integrated Security=True;MultipleActiveResultSets=True"
             providerName="System.Data.SqlClient" />
