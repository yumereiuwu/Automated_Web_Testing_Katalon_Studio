	<appSettings>
		<add key="webpages:Version" value="3.0.0.0" />
		<add key="webpages:Enabled" value="false" />
		<add key="ClientValidationEnabled" value="true" />
		<add key="UnobtrusiveJavaScriptEnabled" value="true" />

		<!-- MoMo sandbox v2 -->
		<add key="Momo:EndpointCreate" value="https://test-payment.momo.vn/v2/gateway/api/create" />
		<add key="Momo:PartnerCode"    value="MOMO" />
		<add key="Momo:AccessKey"      value="F8BBA842ECF85" />
		<add key="Momo:SecretKey"      value="K951B6PE1waDMi640xX08PD3vg6EkVlz" />
		<add key="Momo:RequestType"    value="captureWallet" />
		<add key="Momo:SkipSignature"  value="false" />
		<add key="Momo:AutoMarkPaidOnReturn" value="true" />

		<!-- SMTP cho Quên mật khẩu (OTP Email) -->
		<add key="Mail:SmtpHost" value="smtp.gmail.com" />
		<add key="Mail:SmtpPort" value="587" />
		<add key="Mail:Username" value="yumerei28092005@gmail.com" />
		<add key="Mail:Password" value="iqabrmmhteasbwhh" />
		<add key="Mail:From" value="yumerei28092005@gmail.com" />
		<add key="Mail:EnableSsl" value="true" />

		<!-- VNPAY Sandbox (email cấp cho yumerei28092005@gmail.com) -->
		<add key="Vnpay:TMN_CODE"    value="LTAA0R9W" />
		<add key="Vnpay:HASH_SECRET" value="7O38RJ9GNLEOAOMYQQUBK8V6MUWD1H6J" />
		<add key="Vnpay:URL_PAY"     value="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html" />
		<add key="Vnpay:RETURN_PATH" value="/Vnpay/Return" />
		<!-- Để trống để VNPAY cho chọn phương thức/ngân hàng (NCB...) -->
		<add key="Vnpay:BANK_CODE"   value="" />
	</appSettings>
